# Konfigurasi lokal build dashboard-only.
# Salin file ini menjadi .env, lalu sesuaikan bila perlu.

# --- Path data (relatif ke root proyek) ---
MCP_CCTV_VISION_PATH=config/vision_agent.json
MCP_CCTV_CATALOG_PATH=config/camera_catalog.json
MCP_CCTV_EVENTS_PATH=outputs/events.jsonl
MCP_CCTV_TASKS_PATH=outputs/mcp/tasks.json
MCP_CCTV_AUDIT_PATH=outputs/mcp/audit.jsonl

# --- Aktor audit + izin mutasi ---
# true membuka POST /api/v1/agent/settings dan /api/v1/runtime/* dari localhost.
MCP_ACTOR_ID=dashboard-local
MCP_ENABLE_MUTATIONS=false
