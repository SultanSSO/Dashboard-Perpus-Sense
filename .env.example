# Salin menjadi .env. Jangan commit .env berisi credential.

# Sumber kamera: pilih SNAPSHOT_URL, STREAM_URL, atau native RTSP.
SNAPSHOT_URL=
STREAM_URL=
CCTV_HOST=CAMERA_HOST
CCTV_CHANNEL=13
CCTV_RTSP_URL=
CCTV_USERNAME=USERNAME
CCTV_PASSWORD=PASSWORD
CCTV_RTSP_TRANSPORT=tcp

# Override khusus person_counter.py. Kosong berarti memakai sumber di atas.
PERSON_SOURCE=
CAMERA_ID=1.145-CH13

# Vision inference.
MODEL_PATH=yolo11n.pt
PERSON_MODEL=yolo11n.pt
CONFIDENCE=0.35
PERSON_CONFIDENCE=0.35
IOU=0.50
IMG_SIZE=640
DEVICE=cpu
OUTPUT_DIR=outputs
PERSON_OUTPUT_DIR=outputs/person-counter
SHOW_WINDOW=false
INFER_EVERY_N_FRAMES=1
SNAPSHOT_INTERVAL_SECONDS=0.5
SNAPSHOT_INFERENCE_MODE=predict
ZONE_POLYGON=
FLOW_LINE=

# MCP CCTV. Profil Hermes lokal mengoverride actor dan mutation policy
# khusus subprocess cctv-vision.
MCP_CCTV_VISION_PATH=config/vision_agent.json
MCP_CCTV_CATALOG_PATH=config/camera_catalog.json
MCP_CCTV_EVENTS_PATH=outputs/events.jsonl
MCP_CCTV_TASKS_PATH=outputs/mcp/tasks.json
MCP_CCTV_AUDIT_PATH=outputs/mcp/audit.jsonl
MCP_ACTOR_ID=mcp-local
MCP_ENABLE_MUTATIONS=false

# Deterministic task engine.
TASK_ENGINE_POLL_SECONDS=1

# Hermes LLM/VLM integration (optional).
# These values are a project-side contract. Apply them to the active Hermes
# profile with `hermes config set`; Hermes secrets should remain in the
# profile's secret environment, not in a committed file.
HERMES_MODEL_PROVIDER=custom
HERMES_MODEL_NAME=your-model-id
HERMES_MODEL_BASE_URL=https://api.example.com/v1
HERMES_MODEL_API_KEY=
HERMES_MODEL_API_KEY_ENV=HERMES_MODEL_API_KEY
HERMES_MODEL_CONTEXT_LENGTH=
HERMES_MODEL_TEMPERATURE=
HERMES_MODEL_ENABLE_VISION=false
# Optional fallback, comma-separated provider/model IDs.
HERMES_MODEL_FALLBACKS=
